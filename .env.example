# Optional: Provide a default Anthropic API key.
# If omitted, the proxy will transparently forward the x-api-key sent by Claude Code / VS Code.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Proxy listening port (default: 3000)
PORT=3000

# Target Anthropic endpoint (default: api.anthropic.com)
ANTHROPIC_HOST=api.anthropic.com

# Enable verbose logging (0 = false, 1 = true)
DEBUG=0
